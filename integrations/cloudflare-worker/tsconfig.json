{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src"],
  // d1-refusal.ts runs under plain Node (better-sqlite3), never under
